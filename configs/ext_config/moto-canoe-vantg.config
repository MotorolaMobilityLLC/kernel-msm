    "CONFIG_MOT_DRV_DONGWOON_OIS_AF_DRIFT":"y",
    "CONFIG_MOT_DRV_OIS_AFTER_SALES_SERVICE":"n",
    "CONFIG_MOT_SENSOR_PRE_POWERUP":"n",
    "CONFIG_UFSFEATURE": "y",
