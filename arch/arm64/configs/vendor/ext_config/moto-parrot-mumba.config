#
# Please avoid changing the Qualcomm defconfig files and use this file to
# add any Motorola-specific configuration changes that are applicable to
# userdebug, eng, and user builds.
#
CONFIG_MUMBA_DTB=y
CONFIG_SCHED_MOTO_UNFAIR=m
CONFIG_SCHED_MOTO_BINDERTRANS=m
CONFIG_UFS_SHID_FEATURE=y
CONFIG_UFS_SHID=y
CONFIG_MICRON_UFSHID=y
CONFIG_SCSI_SKHID=y
CONFIG_MMI_LPM_DBG=y
