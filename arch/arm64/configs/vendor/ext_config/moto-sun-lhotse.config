#
# Please avoid changing the Qualcomm defconfig files and use this file to
# add any Motorola-specific configuration changes that are applicable to
# userdebug, eng, and user builds.
#
CONFIG_LEAP_DTB=y
CONFIG_CCI_DEBUG_INTF=y
CONFIG_SCHED_MOTO_UNFAIR=m
CONFIG_AF_NOISE_ELIMINATION=y
CONFIG_MOT_SENSOR_PRE_POWERUP=y
CONFIG_CAM_SENSOR_PROBE_DEBUG=y
CONFIG_UFSFEATURE=y
CONFIG_UFSHID=y
CONFIG_MICRON_UFSHID=y
CONFIG_DRM_DYNAMIC_REFRESH_RATE=y
CONFIG_MOT_SENSOR_STRICT_PERFRAMECONTROL=y
CONFIG_CAM_SENSOR_CTLE_FOR_ORION=y
